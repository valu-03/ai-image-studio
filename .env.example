# Copy this file to .env and fill in the keys you actually have.
# .env is gitignored. Never commit it, never paste its values into a prompt.
# Every tool in this project works without these keys except generate_image.py.

# ---------------------------------------------------------------------------
# Image generation
# ---------------------------------------------------------------------------

# Kie - the default. Resells Nano Banana Pro, so the model this project's
# prompts were tuned for is still what you get.   ->  https://kie.ai/api-key
# This is the only provider that accepts reference images, so character
# consistency needs a Kie key.
KIE_API_KEY=

# Higgsfield Soul. Needs BOTH values - one without the other cannot sign a
# request.                              ->  https://higgsfield.ai/settings/api
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Model ids move. Override without touching code (optional):
# KIE_IMAGE_MODEL=nano-banana-pro
# HIGGSFIELD_IMAGE_MODEL=soul/v2/standard

# ---------------------------------------------------------------------------
# Prompt help - optional
# ---------------------------------------------------------------------------

# OpenRouter powers the Brief tab only: idea -> character spec, prompt rewrite,
# image critique. It generates no images. Leave it blank and everything else
# works; the app just stops offering to improve prompts for you.
#                                        ->  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Text model for the Brief tab (optional):
# OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Testing seams - you will not normally set these
# ---------------------------------------------------------------------------

# Point every provider at another host (the test suite uses this):
# AIVS_API_BASE=http://127.0.0.1:8791

# Read keys from a different file instead of .env:
# AIVS_ENV_FILE=/path/to/other.env
